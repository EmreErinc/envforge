<idea-plugin>
    <id>com.envforge.ide</id>
    <name>EnvForge - AI-Safe Environment Manager</name>
    <version>0.2.2</version>
    <vendor email="emre_erinc@hotmail.com" url="https://github.com/emreerinc/envforge">Emre Erinc</vendor>

  <description><![CDATA[
<p><b>EnvForge</b> is a Rust CLI + TUI for environment variables: named <b>profiles</b>
(dev / staging / prod), <code>.env.schema</code> validation, secret scanning, and encrypted
sync. This plugin is the IntelliJ client for that binary.</p>
<p><b>In the IDE</b></p>
<ul>
<li><b>Tool window</b> — variables (prefix grouping, values masked) and profiles (double-click to switch)</li>
<li><b>LSP</b> — diagnostics, hover, completions, go-to-definition (.env key → schema, and from source that reads env vars)</li>
<li><b>Status bar</b> — variable count and fence indicator</li>
<li><b>Project view</b> — file decorators; Fence Inactive inspection</li>
<li><b>Workflow</b> — validate, scan, export, sync, doctor, generate schema</li>
</ul>
<p><b>Defense (needs the CLI)</b> — fence writes ignore/rules for configured AI tools (not a sandbox);
guard scans on save; MCP config credential warnings; canary gutter icons; audit-logged reveal;
volatile sessions. <code>envforge mcp serve</code> is optional and not in the default brew/GitHub binaries.</p>
<p>Standalone mode: highlighting and sidebar without a binary. Full LSP and profiles:
<code>brew install emreerinc/tap/envforge</code> or <code>cargo install env-forge-tui</code>.
Activates only in a trusted project. Language server uses LSP4IJ.</p>
  ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="envforge-lsp.xml">com.redhat.devtools.lsp4ij</depends>
    <depends>org.toml.lang</depends>

  <extensions defaultExtensionNs="com.intellij">
    <fileType name="EnvForge .env"
              implementationClass="com.envforge.intellij.EnvFileType"
              fieldName="INSTANCE"
              language="EnvForgeEnv"
              extensions="env"
              fileNames=".env"
              patterns=".env.*;*.env"/>
    <!-- Schema files → TOML (exact fileNames beat EnvForge .env glob). -->
    <fileType name="TOML"
              fileNames=".env.schema.toml;.env.schema"/>
    <lang.parserDefinition language="EnvForgeEnv"
                           implementationClass="com.envforge.intellij.EnvParserDefinition"/>
    <toolWindow id="EnvForge"
                anchor="right"
                icon="/icons/envforge.svg"
                factoryClass="com.envforge.intellij.EnvForgeToolWindowFactory"/>
    <statusBarWidgetFactory id="EnvForgeStatus"
                            implementation="com.envforge.intellij.EnvForgeStatusBarFactory"
                            order="after Position"/>
    <notificationGroup id="EnvForge"
                       displayType="BALLOON"/>
    <editorFactoryListener implementation="com.envforge.intellij.EnvForgeExposureEditorListener"/>
    <projectViewNodeDecorator implementation="com.envforge.intellij.EnvForgeProjectViewDecorator"/>
    <postStartupActivity implementation="com.envforge.intellij.EnvForgeStartupCheckActivity"/>
    <localInspection id="FenceInactive"
                     language=""
                     groupName="EnvForge"
                     displayName="Fence Inactive"
                     enabledByDefault="true"
                     level="WARNING"
                     implementationClass="com.envforge.intellij.FenceInactiveInspection"/>
    <fileEditorProvider implementation="com.envforge.intellij.EnvForgeWelcomeFileEditorProvider"/>
  </extensions>

    <actions>
        <!-- File context menu: appears on right-click in project tree and editor for .env files -->
        <group id="EnvForge.FileMenu"
               class="com.envforge.intellij.actions.EnvForgeFileActionGroup"
               text="EnvForge" popup="true"
               icon="/icons/envforge.svg">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </group>

  <group id="EnvForge.Menu" text="EnvForge" popup="true">
        <add-to-group group-id="ToolsMenu" anchor="last"/>

        <action id="EnvForge.ShowWelcome"
                class="com.envforge.intellij.actions.ShowWelcomeAction"
                text="Welcome &amp; Installer"
                description="Show EnvForge Welcome &amp; CLI Installer page"/>

        <separator/>

        <action id="EnvForge.RunWizard"
                class="com.envforge.intellij.actions.RunWizardAction"
                text="Run Project Wizard"
                description="Launch guided EnvForge project setup wizard"/>

        <action id="EnvForge.ProjectInit"
                class="com.envforge.intellij.actions.ProjectInitAction"
                text="Initialize Project (non-interactive)"
                description="Scaffold a new EnvForge project with defaults"/>

        <separator/>

        <action id="EnvForge.List"
                class="com.envforge.intellij.actions.ListAction"
                text="List Variables"
                description="List all environment variables"/>

        <action id="EnvForge.ProfileSwitch"
                class="com.envforge.intellij.actions.ProfileSwitchAction"
                text="Switch Profile..."
                description="Switch to a different profile"/>

        <action id="EnvForge.ProfileDiff"
                class="com.envforge.intellij.actions.ProfileDiffAction"
                text="Diff Profiles..."
                description="Compare two profiles"/>

        <separator/>

        <action id="EnvForge.ToggleFence"
                class="com.envforge.intellij.actions.ToggleFenceAction"
                text="Toggle AI Fence"
                description="Toggle EnvForge Fence on/off"/>

        <action id="EnvForge.ToggleGuard"
                class="com.envforge.intellij.actions.ToggleGuardAction"
                text="Toggle AI Guard"
                description="Toggle EnvForge AI-guard on/off"/>

        <action id="EnvForge.RunMcpScan"
                class="com.envforge.intellij.actions.RunMcpScanAction"
                text="Run MCP Scan"
                description="Scan MCP server configs for security issues"/>

        <action id="EnvForge.AddCanary"
                class="com.envforge.intellij.actions.AddCanaryAction"
                text="Add Canary Token..."
                description="Add a canary token to detect secret exfiltration"/>

        <action id="EnvForge.RemoveCanary"
                class="com.envforge.intellij.actions.RemoveCanaryAction"
                text="Remove Canary Token..."
                description="Remove a canary token"/>

        <separator/>

        <action id="EnvForge.RunLifecycleCheck"
                class="com.envforge.intellij.actions.RunLifecycleCheckAction"
                text="Run Lifecycle Check"
                description="Evaluate all enabled lifecycle rules against current state"/>

        <action id="EnvForge.ManageLifecycleRules"
                class="com.envforge.intellij.actions.ManageLifecycleRulesAction"
                text="Manage Lifecycle Rules"
                description="Show or toggle secret lifecycle rules"/>

        <action id="EnvForge.ViewAuditTrail"
                class="com.envforge.intellij.actions.ViewAuditTrailAction"
                text="View Audit Trail"
                description="View sync and access audit logs"/>

        <action id="EnvForge.ShowUnusedSecrets"
                class="com.envforge.intellij.actions.ShowUnusedSecretsAction"
                text="Show Unused Secrets"
                description="Detect secrets with no access in N days"/>

        <action id="EnvForge.ShowUsageSummary"
                class="com.envforge.intellij.actions.ShowUsageSummaryAction"
                text="Show Usage Summary"
                description="Show analytics summary"/>

        <action id="EnvForge.MonitorStream"
                class="com.envforge.intellij.actions.MonitorStreamAction"
                text="Monitor Stream"
                description="Stream real-time secret access events"/>

        <separator/>

        <action id="EnvForge.Validate"
                class="com.envforge.intellij.actions.ValidateAction"
                text="Validate Against Schema"
                description="Run envforge schema validation"/>

        <action id="EnvForge.Scan"
                class="com.envforge.intellij.actions.ScanAction"
                text="Scan for Secret Leaks"
                description="Scan for leaked secrets"/>

        <action id="EnvForge.Doctor"
                class="com.envforge.intellij.actions.DoctorAction"
                text="Run Health Check"
                description="Run envforge health check"/>

        <action id="EnvForge.Check"
                class="com.envforge.intellij.actions.CheckAction"
                text="Run All Checks"
                description="Run doctor + validate + scan + age + drift"/>

        <action id="EnvForge.Export"
                class="com.envforge.intellij.actions.ExportAction"
                text="Export Variables..."
                description="Export env vars to different formats"/>

        <action id="EnvForge.SyncPush"
                class="com.envforge.intellij.actions.SyncPushAction"
                text="Sync Push"
                description="Push env changes to remote"/>

        <action id="EnvForge.SyncPull"
                class="com.envforge.intellij.actions.SyncPullAction"
                text="Sync Pull"
                description="Pull env changes from remote"/>

        <action id="EnvForge.SyncStatus"
                class="com.envforge.intellij.actions.SyncStatusAction"
                text="Sync Status"
                description="Show sync status"/>

        <action id="EnvForge.SchemaGenerate"
                class="com.envforge.intellij.actions.SchemaGenerateAction"
                text="Generate Schema from .env"
                description="Generate .env.schema from current variables"/>

        <separator/>

        <action id="EnvForge.RunVolatile"
                class="com.envforge.intellij.actions.RunVolatileAction"
                text="Run Command (Volatile Session)..."
                description="Wrap a shell command in a short-lived envforge session"/>

        <action id="EnvForge.RevealValue"
                class="com.envforge.intellij.actions.RevealValueAction"
                text="Reveal Value (Audit-logged)..."
                description="Show a single env var value; reveal is recorded to the envforge audit stream"/>

        <action id="EnvForge.CanaryCheck"
                class="com.envforge.intellij.actions.CanaryCheckAction"
                text="Check Triggered Canaries"
                description="List canary tripwires that have fired"/>

        <action id="EnvForge.CanaryScan"
                class="com.envforge.intellij.actions.CanaryScanAction"
                text="Scan Text/File for Canary Tokens..."
                description="Scan pasted text, a file, or the editor selection for registered canary tokens"/>

        <action id="EnvForge.ExtendLease"
                class="com.envforge.intellij.actions.ExtendLeaseAction"
                text="Extend Volatile Lease..."
                description="Extend the soonest-expiring active envforge lease"/>

        <separator/>

        <action id="EnvForge.RestartLsp"
                class="com.envforge.intellij.actions.RestartLspAction"
                text="Restart Language Server"
                description="Stop and restart the EnvForge LSP server for this project"/>
      </group>
    </actions>
</idea-plugin>
